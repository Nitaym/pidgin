# Google OAuth (required for production login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/auth/google/callback

# Where to send the browser after Google callback
PIDGIN_FRONTEND_URL=http://127.0.0.1:5173

# Enable POST /api/auth/dev-login in local/test environments
PIDGIN_ALLOW_DEV_AUTH=1

# Workspace data directory (used by pidgin-admin --reload and Cursor launch.json)
# PIDGIN_HOME=.pidgin

# LLM backend: stub (offline/tests), anthropic, or litellm (placeholder)
PIDGIN_LLM_BACKEND=stub

# Required when PIDGIN_LLM_BACKEND=anthropic
ANTHROPIC_API_KEY=

# Slack integration (OAuth connect flow)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
