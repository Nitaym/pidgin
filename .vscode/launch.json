{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Pidgin Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "pidgin.api.__main__",
      "args": [
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--reload",
        "--home",
        "${workspaceFolder}/.pidgin"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PIDGIN_ALLOW_DEV_AUTH": "1",
        "PIDGIN_HOME": "${workspaceFolder}/.pidgin",
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "subProcess": true,
      "justMyCode": true
    },
    {
      "name": "Pytest: all",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "tests"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    },
    {
      "name": "Pytest: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "justMyCode": true
    }
  ]
}
